{
  "name": "limia",
  "version": "0.1.0",
  "private": true,
  "description": "A lightweight desktop usage monitor for AI coding tools",
  "main": "dist/main/index.js",
  "author": "Limia",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "tsc -p tsconfig.main.json && vite build && node scripts/copy-assets.cjs",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "npm run build:main && node --test dist/test/**/*.test.js",
    "build:main": "tsc -p tsconfig.main.json",
    "check": "npm run typecheck && npm run test && vite build && node scripts/copy-assets.cjs",
    "package": "npm run build && electron-builder --publish never",
    "package:mac": "npm run build && electron-builder --mac --arm64 --publish never",
    "package:mac:x64": "npm run build && electron-builder --mac --x64 --publish never",
    "package:win": "npm run build && electron-builder --win --x64 --publish never",
    "package:win:arm64": "npm run build && electron-builder --win --arm64 --publish never"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.7.3"
  }
}